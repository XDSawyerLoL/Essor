NODE_ENV=production
PUBLIC_ORIGIN=https://essor-app.fr

# MySQL Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=10
# Alternative possible : DATABASE_URL=mysql://user:password@localhost:3306/database

# Stripe Web
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_URL=

# Google Play Billing
# JSON complet du compte de service, stocké uniquement comme variable d'environnement Hostinger.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
